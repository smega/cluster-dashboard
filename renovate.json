{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "before 9am on monday"
  ],
  "minimumReleaseAge": "14 days",
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Go and npm minor/patch updates in one PR each",
      "matchManagers": [
        "gomod",
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "{{manager}} minor and patch"
    },
    {
      "description": "The shared build workflow must stay on @main: cosign signs with the workflow ref as identity, and the cluster only admits ...build-image.yml@refs/heads/main",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "smega/raspberry-k3s"
      ],
      "enabled": false
    }
  ]
}
